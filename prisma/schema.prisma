generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model cama {
  id_cama          Int
  id_habitacion    Int
  esta_libre       Boolean            @default(true)
  habitacion       habitacion         @relation(fields: [id_habitacion], references: [id_habitacion], onDelete: NoAction, onUpdate: NoAction)
  internacion_cama internacion_cama[]

  @@id([id_cama, id_habitacion])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model comentario {
  id_internacion Int
  id_comentario  Int         @default(autoincrement())
  fecha_hora     DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Timestamp(6)
  descripcion    String?
  id_recorrido   Int
  internacion    internacion @relation(fields: [id_internacion], references: [id_internacion], onDelete: NoAction, onUpdate: NoAction)
  recorrido      recorrido   @relation(fields: [id_recorrido], references: [id_recorrido], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_internacion, id_comentario])
}

model especialidad {
  id_especialidad                 Int                               @id @default(autoincrement())
  nombre                          String                            @unique @db.VarChar(50)
  especialidad_tiene_turnoguardia especialidad_tiene_turnoguardia[]
  med_tiene_esp                   med_tiene_esp[]
}

model especialidad_tiene_turnoguardia {
  id_especialidad  Int
  id_turno_guardia Int
  especialidad     especialidad @relation(fields: [id_especialidad], references: [id_especialidad], onDelete: NoAction, onUpdate: NoAction)
  turnoguardia     turnoguardia @relation(fields: [id_turno_guardia], references: [id_turno_guardia], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_especialidad, id_turno_guardia])
}

model guardia {
  id_guardia                 Int                          @id @default(autoincrement())
  fecha                      DateTime                     @db.Date
  id_especialidad            Int
  nro_matricula              String                       @db.VarChar(4)
  med_tiene_esp              med_tiene_esp                @relation(fields: [id_especialidad, nro_matricula], references: [id_especialidad, nro_matricula], onDelete: NoAction, onUpdate: NoAction)
  guardia_tiene_turnoguardia guardia_tiene_turnoguardia[]
  usuario_modifica_guardia   usuario_modifica_guardia[]
}

model guardia_tiene_turnoguardia {
  id_guardia       Int
  id_turno_guardia Int
  guardia          guardia      @relation(fields: [id_guardia], references: [id_guardia], onDelete: NoAction, onUpdate: NoAction)
  turnoguardia     turnoguardia @relation(fields: [id_turno_guardia], references: [id_turno_guardia], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_guardia, id_turno_guardia])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model habitacion {
  id_habitacion  Int              @id @default(autoincrement())
  piso           Int
  orientacion    String           @db.Char(1)
  id_sector      Int
  cama           cama[]
  sector         sector           @relation(fields: [id_sector], references: [id_sector], onDelete: NoAction, onUpdate: NoAction)
  rond_tiene_hab rond_tiene_hab[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model internacion {
  id_internacion    Int                @id @default(autoincrement())
  fecha_hora_inicio DateTime           @db.Timestamp(6)
  fecha_hora_fin    DateTime?          @db.Timestamp(6)
  nro_matricula     String             @db.VarChar(4)
  nro_dni           String             @db.VarChar(8)
  comentario        comentario[]
  paciente          paciente           @relation(fields: [nro_dni], references: [nro_dni], onDelete: NoAction, onUpdate: NoAction)
  medico            medico             @relation(fields: [nro_matricula], references: [nro_matricula], onDelete: NoAction, onUpdate: NoAction)
  internacion_cama  internacion_cama[]
}

model internacion_cama {
  fecha_hora_asignacion DateTime    @db.Timestamp(6)
  id_internacion        Int
  id_habitacion         Int
  id_cama               Int
  cama                  cama        @relation(fields: [id_cama, id_habitacion], references: [id_cama, id_habitacion], onDelete: NoAction, onUpdate: NoAction)
  internacion           internacion @relation(fields: [id_internacion], references: [id_internacion], onDelete: NoAction, onUpdate: NoAction)

  @@id([fecha_hora_asignacion, id_internacion, id_cama, id_habitacion])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model med_tiene_esp {
  id_especialidad  Int
  nro_matricula    String       @db.VarChar(4)
  max_cant_guardia Int?
  guardia          guardia[]
  especialidad     especialidad @relation(fields: [id_especialidad], references: [id_especialidad], onDelete: NoAction, onUpdate: NoAction)
  medico           medico       @relation(fields: [nro_matricula], references: [nro_matricula], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_especialidad, nro_matricula])
}

model medico {
  nro_matricula String          @id @db.VarChar(4)
  fecha_ingreso DateTime        @db.Date
  foto          Bytes
  cuil          String          @unique @db.VarChar(11)
  cuit          String          @unique @db.VarChar(11)
  nro_dni       String          @unique @db.VarChar(8)
  internacion   internacion[]
  med_tiene_esp med_tiene_esp[]
  persona       persona         @relation(fields: [nro_dni], references: [nro_dni], onDelete: NoAction, onUpdate: NoAction)
  recorrido     recorrido[]
  vacacion      vacacion[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model paciente {
  nro_dni     String        @id @db.VarChar(8)
  sexo        String?       @db.Char(1)
  fecha_nac   DateTime      @db.Date
  internacion internacion[]
  persona     persona       @relation(fields: [nro_dni], references: [nro_dni], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model persona {
  nro_dni  String    @id @db.VarChar(8)
  nombre   String    @db.VarChar(50)
  apellido String    @db.VarChar(50)
  medico   medico?
  paciente paciente?
  usuario  usuario?
}

model recorrido {
  id_recorrido  Int          @id @default(autoincrement())
  fecha         DateTime     @db.Date
  id_ronda      Int
  nro_matricula String       @db.VarChar(8)
  comentario    comentario[]
  ronda         ronda        @relation(fields: [id_ronda], references: [id_ronda], onDelete: NoAction, onUpdate: NoAction)
  medico        medico       @relation(fields: [nro_matricula], references: [nro_matricula], onDelete: NoAction, onUpdate: NoAction)
}

model rond_tiene_hab {
  id_ronda      Int
  id_habitacion Int
  habitacion    habitacion @relation(fields: [id_habitacion], references: [id_habitacion], onDelete: NoAction, onUpdate: NoAction)
  ronda         ronda      @relation(fields: [id_ronda], references: [id_ronda], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_ronda, id_habitacion])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ronda {
  id_ronda               Int                      @id @default(autoincrement())
  dia                    String                   @db.Char(1)
  recorrido              recorrido[]
  rond_tiene_hab         rond_tiene_hab[]
  ronda_tiene_turnoronda ronda_tiene_turnoronda[]
}

model ronda_tiene_turnoronda {
  id_ronda       Int
  id_turno_ronda Int
  ronda          ronda      @relation(fields: [id_ronda], references: [id_ronda], onDelete: NoAction, onUpdate: NoAction)
  turnoronda     turnoronda @relation(fields: [id_turno_ronda], references: [id_turno_ronda], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_ronda, id_turno_ronda])
}

model sector {
  id_sector     Int          @id @default(autoincrement())
  nombre_sector String       @unique @db.VarChar(50)
  habitacion    habitacion[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model turnoguardia {
  id_turno_guardia                Int                               @id @default(autoincrement())
  hora_inicio                     DateTime                          @db.Time(6)
  hora_fin                        DateTime                          @db.Time(6)
  especialidad_tiene_turnoguardia especialidad_tiene_turnoguardia[]
  guardia_tiene_turnoguardia      guardia_tiene_turnoguardia[]

  @@unique([hora_inicio, hora_fin], map: "uq_horario_guardia")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model turnoronda {
  id_turno_ronda         Int                      @id @default(autoincrement())
  hora_inicio            DateTime                 @db.Time(6)
  hora_fin               DateTime                 @db.Time(6)
  ronda_tiene_turnoronda ronda_tiene_turnoronda[]

  @@unique([hora_inicio, hora_fin], map: "uq_horario_ronda")
}

model usuario {
  username                 String                     @id @db.VarChar(50)
  password                 String                     @db.VarChar(50)
  puede_mod_guardia        Boolean?                   @default(false)
  nro_dni                  String                     @unique @db.VarChar(8)
  persona                  persona                    @relation(fields: [nro_dni], references: [nro_dni], onDelete: NoAction, onUpdate: NoAction)
  usuario_modifica_guardia usuario_modifica_guardia[]
}

model usuario_modifica_guardia {
  id_modificacion Int      @default(autoincrement())
  username        String   @db.VarChar(50)
  id_guardia      Int
  fecha_hora      DateTime @db.Timestamp(6)
  descripcion     String?
  guardia         guardia  @relation(fields: [id_guardia], references: [id_guardia], onDelete: NoAction, onUpdate: NoAction)
  usuario         usuario  @relation(fields: [username], references: [username], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_modificacion, username, id_guardia])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vacacion {
  nro_matricula String   @db.VarChar(8)
  id_vacacion   Int      @default(autoincrement())
  fecha_inicio  DateTime @db.Date
  fecha_fin     DateTime @db.Date
  medico        medico   @relation(fields: [nro_matricula], references: [nro_matricula], onDelete: NoAction, onUpdate: NoAction)

  @@id([nro_matricula, id_vacacion])
}
